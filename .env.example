
# PostgreSQL - Main Backend
POSTGRES_DB=skating_db
POSTGRES_USER=skating_user
POSTGRES_PASSWORD=change_me_local_only

# JWT
JWT_SECRET=replace_with_a_secure_random_secret_key_32

# Admin bootstrap (optional)
ADMIN_EMAIL=
ADMIN_PASSWORD=

# PostgreSQL - Payment Service
PAYMENTS_POSTGRES_DB=payments_db
PAYMENTS_POSTGRES_USER=payments_user
PAYMENTS_POSTGRES_PASSWORD=change_me_payment_local_only

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=change_me_redis_local_only

# Kafka - SASL_SSL + SCRAM-SHA-512
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_APP_USERNAME=replace_with_scram_username
KAFKA_APP_PASSWORD=replace_with_scram_password
KAFKA_SSL_STORE_PASSWORD=replace_with_truststore_password
KAFKA_SSL_TRUSTSTORE_LOCATION=../../kafka/secrets/kafka.truststore.jks

# Payment Service
PAYMENT_MOCK_FINAL_STATUS=SUCCEEDED
